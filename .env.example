# Resend API key. When this is unset (or NODE_ENV !== production) the
# /api/contact route logs the payload instead of sending mail.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=hello@graphicstar.ph
# Must be a domain verified in your Resend account.
CONTACT_FROM_EMAIL=website@graphicstar.ph

# Used for absolute URLs in metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.graphicstar.ph
