# Resend API key. When this is unset (or NODE_ENV !== production) the
# /api/contact route logs the payload instead of sending mail.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=hello@graphicstar.ph
# Must be a domain verified in your Resend account.
CONTACT_FROM_EMAIL=website@graphicstar.ph

# Used for absolute URLs in metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.graphicstar.ph

# ---------------------------------------------------------------- Rewards
# Where the SQLite database and uploaded reward/gallery images live.
REWARDS_DATA_DIR=./data
# First admin account, created on first boot if no admin exists yet.
REWARDS_ADMIN_EMAIL=
REWARDS_ADMIN_PASSWORD=
# GSUITE ERP loyalty feed (server/src/routes/loyaltyIntegration.js in the ERP).
# ERP_API_KEY must equal LOYALTY_API_KEY in the ERP's .env. Leave empty to disable the sync.
ERP_API_URL=http://localhost:4000/api/integrations/loyalty
ERP_API_KEY=
# Invoices dated on/after this day earn points.
REWARDS_ERP_SINCE=2025-01-01
# Set to "off" to stop the hourly background sync.
REWARDS_ERP_SYNC=
